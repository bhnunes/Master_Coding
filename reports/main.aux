\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Micro- and macro-averaged DIAGSET test metrics across normalization strategies. Micro metrics pool pixel counts before metric computation, whereas macro metrics compute patient-level values before averaging. Error bars denote 95\% patient-bootstrap confidence intervals where available.}}{5}{figure.2}\protected@file@percent }
