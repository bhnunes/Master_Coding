flowchart LR
    manifest[(master_manifest.sqlite<br/>TRAIN / TRAIN_SELECTED + VALIDATION refs<br/>split bundle/runtime artifact links)]
    shards[Input<br/>Phase 2 HDF5 shards<br/>VALIDATION + TRAIN fallback]
    phase4_outputs[Input<br/>Stage 4 split bundle<br/>+ runtime_normalization_artifacts]
    compact[Optional input<br/>Portable compact TRAIN_SELECTED HDF5/index]
    env[Input<br/>LR finder / auth / registry / normalization config]
    p7[Phase 7<br/>7_lr_finder.py<br/>Direct LR range tests<br/>runtime normalization at load time<br/>OOM retry + divergence stop]
    reports[Output<br/>LR reports + CSV / JSON sidecars<br/>LaTeX/PDF + effective batch size]

    manifest -. read TRAIN or TRAIN_SELECTED<br/>+ VALIDATION rows .-> p7
    shards -. load validation pixels<br/>and canonical TRAIN fallback .-> p7
    phase4_outputs --> p7
    compact -. optional TRAIN_SELECTED .-> p7
    env --> p7
    p7 --> reports
    p7 -. read only .-> manifest
