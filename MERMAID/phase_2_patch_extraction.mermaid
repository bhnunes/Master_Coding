flowchart LR
    wsi[Input<br/>Raw WSIs]
    annotations[Input<br/>Annotations / XML / label policy]
    env[Input<br/>Extraction .env settings]
    artifact_meta[Optional input<br/>Artifact GeoJSON + SQLite tracking]
    p2[Phase 2<br/>2_database_manager.py<br/>Extract canonical patches]
    shards[Output<br/>Canonical Phase 2 patient HDF5 shards]
    manifest[(master_manifest.sqlite<br/>Canonical patch rows)]
    stage2_sidecars[Output<br/>Logs + extraction metadata]

    wsi --> p2
    annotations --> p2
    env --> p2
    artifact_meta -. optional .-> p2
    p2 --> shards
    p2 --> stage2_sidecars
    p2 -. writes canonical rows .-> manifest
