flowchart LR
    manifest[(master_manifest.sqlite<br/>Canonical rows + stage state)]
    phase4_outputs[Input<br/>Phase 4 manifests + run_config + split outputs]
    p5[Phase 5<br/>5_sanity_checks.py<br/>Validate provenance + scientific integrity]
    report[Output<br/>PASS / WARN / FAIL report]

    manifest -. read provenance + row state .-> p5
    phase4_outputs --> p5
    p5 --> report
    p5 -. no write .-> manifest
