flowchart LR
    manifest[(master_manifest.sqlite<br/>Canonical rows + cleaning state)]
    shards[Input<br/>Phase 2 HDF5 shards<br/>Pixel backend for split writing]
    env[Input<br/>Crossfold + normalization config]
    p4[Phase 4<br/>4_crossfold.py<br/>Assign TRAIN / VALIDATION / TEST]
    split_hdf5[Output<br/>Split HDF5 datasets / manifests]
    run_cfg[Output<br/>run_config.json + split_stats.csv + manifest.csv]
    norm_artifacts[Output<br/>Optional normalization artifacts fit on TRAIN]

    manifest -. read canonical rows + cleaning state .-> p4
    shards -. read pixels for split outputs .-> p4
    env --> p4
    p4 --> split_hdf5
    p4 --> run_cfg
    p4 --> norm_artifacts
    p4 -. updates split + normalization state .-> manifest
