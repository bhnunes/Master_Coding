# --- Project Configuration ---

# ============================================================
# Stage 1: Artifact Detection (`1_artifact_detection.py`)
# Copy this file to `.env` and adjust the paths below.
# This script reads slides directly from a zip file, creates a
# SQLite progress database, processes one slide at a time in a
# temporary folder, and saves the final GeoJSON files.
# ============================================================

# Full path to the zip archive that contains the WSI files.
# Supported extensions inside the zip: .svs, .ndpi, .tiff, .tif
ARTIFACT_IMAGES_ZIP=./data/slides.zip

# Folder where the final GeoJSON files generated by
# `1_artifact_detection.py` will be saved.
ARTIFACT_GEOJSON_OUTPUT=./artifacts/geojson

# Folder where the SQLite tracking database for
# `1_artifact_detection.py` will be created.
ARTIFACT_DATABASE_FOLDER=./databases

# Optional custom name for the Stage 1 database file.
ARTIFACT_DATABASE_NAME=artifact_detection.db

# Temporary working folder used while processing one slide at a time.
# The script cleans this folder during execution.
ARTIFACT_TEMP_FOLDER=./temp/artifact_detection

# Folder used to store Stage 1 logs.
ARTIFACT_LOG_FOLDER=./logs

# Device used for inference. Common values: cuda, cpu, mps
ARTIFACT_DEVICE=cuda

# Tissue detector model folder and filename.
ARTIFACT_TD_MODEL_DIR=./models/td
ARTIFACT_TD_MODEL_NAME=Tissue_Detection_MPP10.pth

# QC model folder. The file is selected automatically from
# `ARTIFACT_MPP_MODEL`.
ARTIFACT_QC_MODEL_DIR=./models/qc

# Choose the QC model magnification value.
# Allowed values: 1.0, 1.5, 2.0
ARTIFACT_MPP_MODEL=1.5

# Optional overlay reduction factor for QC preview images.
ARTIFACT_OVERLAY_FACTOR=10

# ============================================================
# Stage 2: Database Manager + Patch Extraction
# `OPENSLIDE_PATH` behavior is OS-aware:
# - Native Windows: required, must point to the OpenSlide `bin` folder.
# - Linux / containers / Colab: ignored.
#
# Performance note:
# - Native Windows is preferred when inputs and outputs live on Windows disks.
# - WSL-mounted paths such as /mnt/c and /mnt/d can be much slower for
#   large patch extraction workloads.
# ============================================================

# A unique tag for the experiment (e.g., 'LUNG_CANCER_V1'). Used for folder and table names.
TAG=CHILE

# Path to the SQLite database file.
SQLITE_DB_PATH=./databases/database.db

# Base path where project folders will be created.
PROJECTS_BASE_PATH=./projects/CHILE

# Patch extraction parameters.
# Windows example:
# OPENSLIDE_PATH=C:\openslide\bin
OPENSLIDE_PATH=
WINDOW_SIZE=224
STRIDE=112
TARGET_LEVEL=0
TISSUE_PERCENTAGE=0.3
MATCH_PERCENTAGE=1.0
LOADCASES=False

# Artifact-aware metadata generation.
# When enabled, Stage 2 computes per-class artifact coverage for each saved patch
# and writes `artifact_patch_index.parquet`. When disabled, it still writes the
# parquet file with zero-valued coverage columns for faster ablation runs.
USE_ADVANCED_ARTIFACT_FILTERING=True
ACTIVATE_SANITY_CHECK_GEOJSON=True
GEOJSON_PATH=./artifacts/geojson

# ============================================================
# Stage 4: Optimization Sampling (`4_1_optimization_sampling.py`)
# This script builds the pilot sample and master candidate pool
# used for human-in-the-loop review of cancer patches.
# ============================================================

# Source folders with cancer images and their paired masks.
OPTIMIZATION_SAMPLING_IMAGE_FOLDER=./projects/CHILE/PATCHES/CANCER
OPTIMIZATION_SAMPLING_MASK_FOLDER=./projects/CHILE/PATCHES/CANCER_MASK

# Output folder that will receive `pilot_sample` and
# `master_candidate_pool`.
OPTIMIZATION_SAMPLING_OUTPUT_BASE=./projects/CHILE/Optimization_Test

# Logging configuration.
OPTIMIZATION_SAMPLING_LOG_FOLDER=./logs
OPTIMIZATION_SAMPLING_LOG_FILE=optimization_sampling.log

# Statistical sampling parameters.
OPTIMIZATION_SAMPLING_CONFIDENCE_LEVEL=0.95
OPTIMIZATION_SAMPLING_MARGIN_OF_ERROR=0.05
OPTIMIZATION_SAMPLING_PROPORTION=0.5
OPTIMIZATION_SAMPLING_PILOT_SAMPLE_SIZE=100
OPTIMIZATION_SAMPLING_MASTER_POOL_FRACTION=0.10

# Overlay rendering parameters.
OPTIMIZATION_SAMPLING_OVERLAY_COLOR_B=0
OPTIMIZATION_SAMPLING_OVERLAY_COLOR_G=0
OPTIMIZATION_SAMPLING_OVERLAY_COLOR_R=255
OPTIMIZATION_SAMPLING_OVERLAY_THICKNESS=2
OPTIMIZATION_SAMPLING_OVERLAY_ALPHA=1.0

# Parallel execution. Leave blank to use all detected CPU cores.
OPTIMIZATION_SAMPLING_NUM_PROCESSES=

# ============================================================
# Stage 4.2: Graph Method Tuning (`4_2_tune_graph_method.py`)
# This script tunes graph-segmentation parameters using the manual
# labels created in `master_candidate_pool/APPROVED` and `REJECTED`.
# ============================================================

# Source folders with the original cancer images and masks.
GRAPH_TUNING_SOURCE_IMAGE_FOLDER=./projects/CHILE/PATCHES/CANCER
GRAPH_TUNING_SOURCE_MASK_FOLDER=./projects/CHILE/PATCHES/CANCER_MASK

# Folder that contains `APPROVED` and `REJECTED` review labels.
GRAPH_TUNING_BASE_DIR=./projects/CHILE/Optimization_Test/master_candidate_pool

# Logging configuration.
GRAPH_TUNING_LOG_FOLDER=./logs
GRAPH_TUNING_LOG_FILE=bayesian_optimization.log
GRAPH_TUNING_OUTPUT_PARAMS_PATH=./projects/CHILE/Optimization_Test/master_candidate_pool/graph_cleaning_params.json

# Dataset split and optimization budget.
GRAPH_TUNING_TEST_SET_SIZE=0.2
GRAPH_TUNING_N_SPLITS_INNER_CV=3
GRAPH_TUNING_N_BAYESIAN_CALLS=50
GRAPH_TUNING_N_INITIAL_POINTS=10
GRAPH_TUNING_RANDOM_STATE=42

# Search-space bounds for Bayesian optimization.
GRAPH_TUNING_BG_INTENSITY_MIN=100
GRAPH_TUNING_BG_INTENSITY_MAX=250
GRAPH_TUNING_K_MIN=100
GRAPH_TUNING_K_MAX=500
GRAPH_TUNING_MIN_SIZE_MIN=10
GRAPH_TUNING_MIN_SIZE_MAX=200
GRAPH_TUNING_EROSION_MIN=0
GRAPH_TUNING_EROSION_MAX=10

# ============================================================
# Stage 4.3: Graph Cleaning (`4_3_cleaner_script.py`)
# This script applies the tuned graph-contamination rule to move
# rejected image/mask pairs into dedicated output folders.
# ============================================================

# Source folders with the original cancer images and masks.
GRAPH_CLEANING_SOURCE_IMAGE_DIR=./projects/CHILE/PATCHES/CANCER
GRAPH_CLEANING_SOURCE_MASK_DIR=./projects/CHILE/PATCHES/CANCER_MASK

# Base folder where `REJECTED_IMAGES` and `REJECTED_MASKS` are created.
GRAPH_CLEANING_OUTPUT_BASE_DIR=./projects/CHILE/PATCHES

# Logging configuration.
GRAPH_CLEANING_LOG_FOLDER=./logs
GRAPH_CLEANING_LOG_FILE=production_filtering.log
GRAPH_CLEANING_PARAMS_PATH=./projects/CHILE/Optimization_Test/master_candidate_pool/graph_cleaning_params.json

# Parallel execution. Leave blank to use all detected CPU cores.
GRAPH_CLEANING_NUM_WORKERS=

# Tuned graph parameters and decision threshold.
GRAPH_CLEANING_BG_INTENSITY_THRESH=198
GRAPH_CLEANING_K=386
GRAPH_CLEANING_MIN_SIZE=200
GRAPH_CLEANING_EROSION_PX=0
GRAPH_CLEANING_TAU=0.24

# ============================================================
# Stage 5: Crossfold Dataset Preparation (`5_crossfold.py`)
# This script creates patient-level TRAIN / VALIDATION / TEST
# splits and can optionally fit stain normalization on TRAIN only.
# ============================================================

# Root folder produced by Stage 2 or Stage 4.3 that contains:
# `CANCER`, `NOT_CANCER`, `CANCER_MASK`, and `NOT_CANCER_MASK`.
CROSSFOLD_DATA_DIRECTORY=./projects/CHILE/PATCHES

# Output behavior.
# - `NOT_NORMALIZED` keeps raw staining and moves files into split folders.
# - `REINHARD`, `RUIFROK`, `MACENKO`, `VAHADANE` write normalized images
#   while copying masks unchanged.
CROSSFOLD_NORMALIZATION_METHOD=NOT_NORMALIZED

# Random seed used for split search reproducibility.
CROSSFOLD_RANDOM_STATE=42

# If `True`, the stage deletes an existing output run folder such as
# `PATCHES/NOT_NORMALIZED/NOT_NORMALIZED_seed_42` before recreating it.
CROSSFOLD_OVERWRITE_OUTPUT_DIR=True

# Patient-count guardrails for TRAIN / VALIDATION / TEST.
# When `CROSSFOLD_ADAPTIVE=True`, the script relaxes these minimums when the
# dataset is too small to satisfy them exactly.
CROSSFOLD_MIN_TRAIN_PATIENTS=5
CROSSFOLD_MIN_VAL_PATIENTS=5
CROSSFOLD_MIN_TEST_PATIENTS=20

# Target split ratios used during patient-level split sizing.
CROSSFOLD_TEST_RATIO=0.10
CROSSFOLD_VAL_RATIO=0.10

# If `True`, require TRAIN to contain more images than VALIDATION and TEST.
CROSSFOLD_REQUIRE_TRAIN_IMAGE_DOMINANCE=True

# If the dataset contains both classes, try to keep both classes present in
# every split. Set to `False` only for very small or highly imbalanced cohorts.
CROSSFOLD_REQUIRE_BOTH_CLASSES_IF_POSSIBLE=True

# Maximum number of randomized patient-level split attempts to evaluate.
CROSSFOLD_MAX_TRIES=1000

# Allow the stage to relax minimum patient counts when the cohort is too small.
CROSSFOLD_ADAPTIVE=True

# Enable entropy-based objective search across feasible splits.
# If `False`, the first feasible split is accepted.
CROSSFOLD_ENABLE_OBJECTIVE=True

# Which split to score when the entropy objective is enabled.
# Allowed values: TRAIN, VALIDATION, TEST.
CROSSFOLD_OBJECTIVE_SCORE_SPLIT=TRAIN

# If `True`, pick the highest-scoring feasible split. If `False`, pick the lowest.
CROSSFOLD_OBJECTIVE_MAXIMIZE=True

# Parallel entropy settings.
# Leave `CROSSFOLD_ENTROPY_NUM_WORKERS` blank to use the stage default
# (`cpu_count - 1`, with a floor of 1).
CROSSFOLD_ENTROPY_NUM_WORKERS=

# Batch size passed to multiprocessing when scoring image entropy.
CROSSFOLD_ENTROPY_CHUNKSIZE=128

# Thumbnail size used before entropy calculation. Smaller values are faster,
# larger values preserve more spatial detail.
CROSSFOLD_ENTROPY_THUMBNAIL=128

# If `True`, save `entropy_cache.csv` and `patient_entropy_median.csv`
# inside the output run folder.
CROSSFOLD_SAVE_ENTROPY_CACHE_CSV=True

# If `True`, compute SHA256 hashes for all written images and masks before
# saving `manifest.csv`. This can be very slow on large datasets.
CROSSFOLD_CALC_CHECKSUMS=False

# ============================================================
# Stage 6: Scientific Sanity Checks (`6_sanity_checks.py`)
# This script verifies whether the Stage 5 dataset is scientifically
# defensible before packing or training.
# ============================================================

# Folder produced by Stage 5 that contains `manifest.csv`, `split_stats.csv`,
# `run_config.json`, and the TRAIN / VALIDATION / TEST split folders.
SANITY_BASE_DIR=./projects/CHILE/PATCHES/NOT_NORMALIZED/NOT_NORMALIZED_seed_42

# Number of image/mask pairs to sample for expensive checks when full scans are disabled.
SANITY_SAMPLE_PAIRS=1000

# If `True`, scan every mask for unexpected pixel values instead of only a sample.
SANITY_FULL_MASK_SCAN=False

# If `True`, decode every image/mask pair and verify matching spatial dimensions.
SANITY_FULL_SHAPE_SCAN=False

# Checksum verification mode.
# - `OFF`: skip SHA256 verification completely.
# - `SAMPLE`: verify a sample of rows when checksum columns exist in the manifest.
# - `FULL`: verify every row when checksum columns exist in the manifest.
SANITY_CHECKSUM_MODE=SAMPLE

# If `True`, fail when the same filename appears more than once anywhere in the dataset.
# This protects downstream filename-keyed joins used by artifact-aware training.
SANITY_ENFORCE_FILENAME_UNIQUENESS=True

# If `True`, fail when filenames do not match the expected `PATIENT_<id>_...`
# pattern or when the embedded patient id disagrees with `manifest.csv`.
SANITY_ENFORCE_REGEX_PATIENT_ID_MATCH=True

# If `True`, recompute split-level statistics from `manifest.csv` and compare them
# against the stored `split_stats.csv` provenance artifact.
SANITY_ENFORCE_SPLIT_STATS_PARITY=True

# If `True`, fail when a positive (`CANCER`) sample has an empty mask.
# Set to `False` only if your labeling policy intentionally allows context-only positives.
SANITY_FAIL_ON_EMPTY_CANCER_MASK=True

# If `True`, fail when a negative (`NOT_CANCER`) sample contains positive mask pixels.
SANITY_FAIL_ON_POSITIVE_NOT_CANCER_MASK=True

# ============================================================
# Stage 7: HDF5 Packaging (`7_pack_splits_to_hdf5.py`)
# This script converts Stage 5 split folders into the minimal HDF5
# files consumed by Stage 8 training.
# ============================================================

# Stage 5 output folder containing TRAIN / VALIDATION / TEST split directories.
PACKAGING_BASE_DIR=./projects/CHILE/PATCHES/NOT_NORMALIZED/NOT_NORMALIZED_seed_42

# Optional destination folder for TRAIN.h5 / VALIDATION.h5 / TEST.h5.
# Leave blank to write the HDF5 files into `PACKAGING_BASE_DIR`.
PACKAGING_OUTPUT_DIR=

# Comma-separated split list to package. `TEST` remains optional on disk.
PACKAGING_SPLITS=TRAIN,VALIDATION,TEST

# Final square size used when writing images and masks into HDF5.
PACKAGING_IMG_SIZE=224

# Regex used to extract `patient_ids` from filenames.
PACKAGING_PATIENT_ID_REGEX=PATIENT_(\d+)_

# If `True`, rebuild HDF5 outputs even when they already exist.
PACKAGING_OVERWRITE_OUTPUTS=False

# ============================================================
# Stage 8: Smart Sampling (`8_smart_sampler.py`)
# This script filters `TRAIN.h5` into `TRAIN_FILTERED.h5`
# for downstream `9_lr_finder.py` and `10_training_ensemble.py`.
# ============================================================

# Input HDF5 file produced by Stage 7.
SMART_SAMPLER_SOURCE_H5=./data/CAMELYON16/TRAIN.h5

# Folder where `TRAIN_FILTERED.h5` and optional sidecars are written.
SMART_SAMPLER_OUTPUT_DIR=./data/CAMELYON16

# Output file name expected by downstream training scripts.
SMART_SAMPLER_OUTPUT_FILENAME=TRAIN_FILTERED.h5

# Optional scratch directory used when staging the input HDF5 locally.
SMART_SAMPLER_LOCAL_WORK_DIR=./temp/smart_sampling
SMART_SAMPLER_STAGE_INPUT_LOCALLY=False

# Write CSV/JSON diagnostics alongside the filtered HDF5.
SMART_SAMPLER_WRITE_SIDECARS=True
SMART_SAMPLER_OVERWRITE_OUTPUT=False

# Embedding extractor runtime.
SMART_SAMPLER_ENCODER_NAME=resnet50
SMART_SAMPLER_ENCODER_WEIGHTS=imagenet
SMART_SAMPLER_INPUT_SIZE=224
SMART_SAMPLER_BATCH_SIZE=128
SMART_SAMPLER_DEVICE=cuda
SMART_SAMPLER_NUM_WORKERS=2
SMART_SAMPLER_SEED=42

# Adaptive stability loop.
SMART_SAMPLER_N_START=512
SMART_SAMPLER_N_MAX=15000
SMART_SAMPLER_GROWTH_FACTOR=2.0
SMART_SAMPLER_STABILITY_THRESHOLD=0.85
SMART_SAMPLER_STABILITY_REPEATS=3
SMART_SAMPLER_MAX_STEPS=7
SMART_SAMPLER_INTERSECTION_RATIO_THRESHOLD=0.2

# Clustering and per-patient sample caps.
SMART_SAMPLER_K_MIN=20
SMART_SAMPLER_K_MAX=80
SMART_SAMPLER_M_MAX=2000
SMART_SAMPLER_SELECTION_STRATEGY=uniform

# ============================================================
# Stage 9: LR Finder (`9_lr_finder.py`)
# This script screens the approved model registry, runs repeated
# LR finder sweeps, and compiles a LaTeX PDF report.
# ============================================================

# Folder containing TRAIN.h5 and optionally TRAIN_FILTERED.h5.
LR_FINDER_HDF5_DRIVE_DIR=./data/CAMELYON16

# Output folder that receives plots, CSVs, report.tex, report.pdf,
# and lr_finder_run_config.json.
LR_FINDER_OUTPUT_DIR=./reports/lr_finder

# Optional local cache/staging folder used when copying the selected
# training HDF5 off slower storage before screening.
LR_FINDER_LOCAL_DATA_DIR=./temp/lr_finder
LR_FINDER_STAGE_INPUT_LOCALLY=False

# Output management and input selection.
LR_FINDER_OVERWRITE_OUTPUT=True
LR_FINDER_SMART_SAMPLING=True
LR_FINDER_PDF_NAME=report.pdf

# Reproducibility and runtime mode.
LR_FINDER_EXECUTION_MODE=FAST_DEV
LR_FINDER_AMP_PRECISION=fp16
LR_FINDER_SEED=24
LR_FINDER_BATCH_SIZE=32
LR_FINDER_WORKERS=8

# Optional comma-separated subset of approved architectures from
# training_model_registry.json. Leave blank to screen them all.
LR_FINDER_ARCHITECTURES=

# Optional subset mode for faster smoke tests.
LR_FINDER_USE_SUBSET=False
LR_FINDER_SUBSET_RATIO=1.0

# LR Finder sweep settings.
LR_FINDER_NUM_LHS_SAMPLES=12
LR_FINDER_NUM_REPEATS=3
LR_FINDER_END_LR=0.1
LR_FINDER_NUM_ITER=100
LR_FINDER_OPTIMIZER_START_LR=1e-8
LR_FINDER_OPTIMIZER_WEIGHT_DECAY=1e-4

# BCE + Dice search space for Stage 9 loss screening.
LR_FINDER_ALPHA_MIN=0.1
LR_FINDER_ALPHA_MAX=1.0
LR_FINDER_BETA_MIN=0.1
LR_FINDER_BETA_MAX=0.5
LR_FINDER_GAMMA_MIN=0.1
LR_FINDER_GAMMA_MAX=0.5
LR_FINDER_GAMMA_LOG=False

# ============================================================
# Stage 11: Ensemble Optimizer (`11_optimizer_ensemble.py`)
# This script optimizes the two-stream ensemble recipe consumed
# by Stage 12 inference and writes a declarative JSON artifact.
# ============================================================

# --- Dataset, metadata, and output paths ---
# Folder containing VALIDATION.h5.
ENSEMBLE_OPT_HDF5_DRIVE_DIR=./data/CAMELYON16
# Folder containing *_meta.json files produced by training.
ENSEMBLE_OPT_METADATA_DIR=./metadata/CAMELYON16
# Folder where the final ensemble recipe JSON is written.
ENSEMBLE_OPT_OUTPUT_DIR=./reports/ensemble_optimizer
# Optional local staging folder for VALIDATION.h5 when fast local disk is available.
ENSEMBLE_OPT_LOCAL_DATA_DIR=./temp/ensemble_optimizer
# Folder for cached per-model validation predictions.
ENSEMBLE_OPT_PRED_CACHE_DIR=./temp/ensemble_optimizer_cache
ENSEMBLE_OPT_STAGE_INPUT_LOCALLY=True
ENSEMBLE_OPT_OVERWRITE_OUTPUT=True

# --- Reproducibility and dataloader ---
ENSEMBLE_OPT_SEED=24
ENSEMBLE_OPT_BATCH_SIZE=32
ENSEMBLE_OPT_WORKERS=8

# --- Candidate model selection ---
ENSEMBLE_OPT_TOP_MODELS=8
ENSEMBLE_OPT_SORT_METRIC=best_val_auprc_pixel_score

# --- Holdout split ---
ENSEMBLE_OPT_VAL_HOLDOUT_FRAC=0.20

# --- Two-stream grouping ---
ENSEMBLE_OPT_SEMANTIC_ARCHITECTURES=SWIN,DPT,SEGFORMER,UPERNET
ENSEMBLE_OPT_SPATIAL_ARCHITECTURES=DEEPLABV3PLUS,UNET++,FPN,MANET

# --- ROI guardrails ---
ENSEMBLE_OPT_ROI_CONTEXT_SCALE=4
ENSEMBLE_OPT_ROI_MAX_MEDIAN=0.60
ENSEMBLE_OPT_ROI_EMPTY_MAX=0.50
ENSEMBLE_OPT_ROI_MIN_POS_RECALL=0.80

# --- Spatial optimization ---
ENSEMBLE_OPT_SPILL_PENALTY_LAMBDA=0.10
ENSEMBLE_OPT_SPATIAL_PATIENT_POLICY=positive_only

# --- Optuna ---
ENSEMBLE_OPT_NUM_TRIALS_SEMANTIC=50
ENSEMBLE_OPT_NUM_TRIALS_SPATIAL=50

# ============================================================
# Stage 10: Training Ensemble (`10_training_ensemble.py`)
# This script trains one segmentation model per execution.
# Keep the values below together so users can quickly identify
# where the configuration for this script starts.
# ============================================================

# --- Model selection ---
# Approved research architectures and required encoder pairs:
# - SWIN -> tu-swin_large_patch4_window7_224.ms_in22k_ft_in1k
# - DEEPLABV3PLUS -> tu-resnest101e
# - UNET++ -> efficientnet-b7
# - FPN -> senet154
# - SEGFORMER -> mit_b5
# - MANET -> resnet152
# - DPT -> tu-vit_large_patch16_224.augreg_in21k_ft_in1k
# - UPERNET -> tu-hiera_large_224
# Use exactly one of the architecture values above and the matching encoder.
TRAINING_ARCHITECTURE=FPN
TRAINING_ENCODER=senet154
# Optional checkpoint path used to resume training.
TRAINING_RESUME_CHECKPOINT=
# Optional override for the approved architecture/encoder registry JSON.
TRAINING_MODEL_REGISTRY_PATH=./training_model_registry.json

# --- Dataset and output paths ---
# Folder containing TRAIN.h5 / TRAIN_FILTERED.h5 and VALIDATION.h5.
TRAINING_HDF5_DRIVE_DIR=./data/CAMELYON16
# Parquet file produced by Stage 2 with filename-keyed artifact coverage metadata.
TRAINING_ARTIFACT_INDEX_PATH=./projects/CHILE/PATCHES/artifact_patch_index.parquet
# Folder where JSON metadata for the best checkpoint is saved.
TRAINING_METADATA_DIR=./metadata/CAMELYON16
# Local cache/staging folder for copied HDF5 files.
TRAINING_LOCAL_DATA_DIR=./temp/training_ensemble
# Folder where model checkpoints are written.
TRAINING_CHECKPOINT_PATH=./checkpoints
# Aim repository folder for experiment tracking.
TRAINING_AIM_REPO_PATH=./aim_repo

# --- Run identity and reproducibility ---
TRAINING_IDENTIFIER=CAMELYON16_HDF5_OPTIMIZED
TRAINING_EXECUTION_MODE=FAST_DEV
TRAINING_SEED=24
TRAINING_SMART_SAMPLING=True
TRAINING_UNLEASHED=False
TRAINING_USE_ARTIFACT_AWARE_LOSS=False

# --- Training loop ---
TRAINING_NUM_EPOCHS=100
TRAINING_PATIENCE=5
TRAINING_BATCH_SIZE=32
TRAINING_VAL_BATCH_MULTIPLIER=3
TRAINING_ACCUMULATION_STEPS=4
TRAINING_WORKERS=8
TRAINING_OPTIMIZER_NAME=AdamWScheduleFree
TRAINING_AMP_PRECISION=fp16

# --- Loss and metric behavior ---
TRAINING_ALPHA_BCE=0.125
TRAINING_BETA_DICE_BG=0.157
TRAINING_GAMMA_DICE_FG=0.173
TRAINING_SENSITIVITY_TARGET=0.95

# --- Optional notifications ---
# Leave these blank to disable email notifications.
TRAINING_EMAIL_SENDER=
TRAINING_EMAIL_RECIPIENTS=
TRAINING_EMAIL_PASSWORD=
