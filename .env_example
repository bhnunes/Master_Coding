# --- Project Configuration ---

# Shared runtime log folder used by all stages. Change this once to redirect
# all `.log` files to a different location.
LOG_FOLDER=/mnt/host_c/logs

# ============================================================
# Stage 1: Artifact Detection (`1_artifact_detection.py`)
# Copy this file to `.env` and adjust the paths below.
# This script reads slides directly from a zip file, creates a
# SQLite progress database, processes one slide at a time in a
# temporary folder, and saves the final GeoJSON files.
# ============================================================

# Full path to the zip archive that contains the WSI files.
# Supported extensions inside the zip: .svs, .ndpi, .tiff, .tif
ARTIFACT_IMAGES_ZIP=./data/slides.zip

# Folder where the final GeoJSON files generated by
# `1_artifact_detection.py` will be saved.
ARTIFACT_GEOJSON_OUTPUT=./artifacts/geojson

# Folder where the SQLite tracking database for
# `1_artifact_detection.py` will be created.
ARTIFACT_DATABASE_FOLDER=./databases

# Optional custom name for the Stage 1 database file.
ARTIFACT_DATABASE_NAME=artifact_detection.db

# Temporary working folder used while processing one slide at a time.
# The script cleans this folder during execution.
ARTIFACT_TEMP_FOLDER=./temp/artifact_detection

# Stage 1 log filename written inside `LOG_FOLDER`.
ARTIFACT_LOG_FILE=artifact_detection.log

# Device used for inference. Common values: cuda, cpu, mps
ARTIFACT_DEVICE=cuda

# Tissue detector model folder and filename.
ARTIFACT_TD_MODEL_DIR=./models/td
ARTIFACT_TD_MODEL_NAME=Tissue_Detection_MPP10.pth

# QC model folder. The file is selected automatically from
# `ARTIFACT_MPP_MODEL`.
ARTIFACT_QC_MODEL_DIR=./models/qc

# Choose the QC model magnification value.
# Allowed values: 1.0, 1.5, 2.0
ARTIFACT_MPP_MODEL=1.5

# Optional overlay reduction factor for QC preview images.
ARTIFACT_OVERLAY_FACTOR=10

# ============================================================
# Stage 2: Database Manager + Patch Extraction
# `OPENSLIDE_PATH` behavior is OS-aware:
# - Native Windows: required, must point to the OpenSlide `bin` folder.
# - Linux / containers / Colab: ignored.
#
# Performance note:
# - Native Windows is preferred when inputs and outputs live on Windows disks.
# - WSL-mounted paths such as /mnt/c and /mnt/d can be much slower for
#   large patch extraction workloads.
# ============================================================

# A unique tag for the experiment (e.g., 'LUNG_CANCER_V1'). Used for folder and table names.
# Special Stage 2 behavior:
# - `TAG=HISEG` enables the HISEG-specific `.svs/.xml` parser.
# - HISEG uses ASAP-style XML (`Annotation Color="#..."` with `Coordinates/Coordinate`).
# - HISEG label colors are hardcoded in code, so Stage 2 does not require
#   `CANCER_COLOR` / `NOT_CANCER_COLOR` to be filled in the SQLite database.
# - `TAG=Chile` enables the CHILE-specific `.svs/.xml` line-color policy.
# - CHILE uses hardcoded XML `LineColor` values, so Stage 2 does not require
#   `CANCER_COLOR` / `NOT_CANCER_COLOR` to be filled in the SQLite database.
#   cancer     -> 255
#   not_cancer -> 65280 or 65408
# - Other `.svs/.xml` datasets keep the existing DB-driven color workflow.
TAG=CHILE

# Slow-storage source root for Stage 2. This folder must contain these subfolders:
# - `IMAGES` with raw WSI files
# - `ANNOTATIONS` with matching annotation files
# - `GEOJSON` with matching artifact GeoJSON files when artifact filtering or
#   GeoJSON sanity checking is enabled
SOURCE_FOLDER=/mnt/host_e

# Path to the SQLite database file.
SQLITE_DB_PATH=/mnt/host_c/database/database.db

# Fast-storage output root for Stage 2 artifacts.
# Stage 2 writes `PATCHES/`, HDF5 shards, and `master_manifest.sqlite` here.
PROJECTS_BASE_PATH=/mnt/host_f/CHILE_OUTPUT

# Optional Stage 2 local-slide staging.
# Use this when the original WSI files live on an external SSD or slower storage.
# When enabled, Stage 2 copies one WSI at a time into the local cache directory,
# processes it there, then deletes the staged copy before moving to the next slide.
STAGE2_COPY_WSI_TO_LOCAL_CACHE=True
STAGE2_LOCAL_SLIDE_CACHE_DIR=/mnt/host_f/local_slide_cache

# Patch extraction parameters.
# Windows example:
# OPENSLIDE_PATH=C:\openslide\bin
OPENSLIDE_PATH=
WINDOW_SIZE=224
STRIDE=112
TARGET_LEVEL=0
HISEG_XML_COORD_LEVEL=6
TISSUE_PERCENTAGE=0.3
MATCH_PERCENTAGE=1.0
LOADCASES=False
NUM_WORKERS=3

# Stage 2 OpenSlide/runtime cache controls.
# Set both to `0` to keep defaults.
OPENSLIDE_CACHE_BYTES=0
STAGE2_PRELOAD_SCAN_AREA_MAX_BYTES=0

# Stage 2 HDF5 shard compression.
# - `gzip`: smallest files, slowest writes
# - `lzf`: faster compressed writes
# - `none`: fastest writes, largest files
STAGE2_HDF5_COMPRESSION=none

# Stage 2 `.svs/.xml` note:
# - `TAG=Chile` does not require manual DB color assignment after ingestion.
#   Stage 2 maps these XML `LineColor` values internally:
#   cancer     -> 255
#   not_cancer -> 65280 or 65408
# - HISEG does not: once `TAG=HISEG`, Stage 2 maps these XML colors internally:
#   cancer     -> #8B0000, #FF00FF, #800080
#   not_cancer -> #8A2BE2, #0000FF, #4682B4, #00FF00, #008000, #FFFF00
#   rejected   -> #4B0082

# Artifact-aware metadata generation.
# When enabled, Stage 2 computes per-class artifact coverage for each saved patch
# and stores those compact coverage values in `master_manifest.sqlite`. When
# disabled, it still persists the same SQLite-backed coverage fields as zeros for
# faster ablation runs.
# GeoJSON files are resolved automatically from `SOURCE_FOLDER/GEOJSON`.
USE_ADVANCED_ARTIFACT_FILTERING=True
ACTIVATE_SANITY_CHECK_GEOJSON=True

# Stage 2 log filename written inside `LOG_FOLDER`.
EXTRACTION_LOG_FILE=database_manager.log

# ============================================================
# Stage 3.1: Optimization Sampling (`3_1_optimization_sampling.py`)
# This script builds the pilot sample and master candidate pool
# used for human-in-the-loop review of cancer patches.
# ============================================================

# Preferred HDF5-first source for Stage 3.1. Stage 3.1 reads rows from this
# canonical dataset and exports only the review PNG overlays required by the
# manual workflow.
OPTIMIZATION_SAMPLING_SOURCE_HDF5_PATH=/mnt/host_f/CHILE_OUTPUT/PATCHES/SOURCE_DATASET.h5

# Output folder that will receive `pilot_sample` and
# `master_candidate_pool`.
OPTIMIZATION_SAMPLING_OUTPUT_BASE=/mnt/host_f/CHILE_OUTPUT/Optimization_Test

# Stage 3.1 log filename written inside `LOG_FOLDER`.
OPTIMIZATION_SAMPLING_LOG_FILE=optimization_sampling.log

# Statistical sampling parameters.
OPTIMIZATION_SAMPLING_CONFIDENCE_LEVEL=0.95
OPTIMIZATION_SAMPLING_MARGIN_OF_ERROR=0.05
OPTIMIZATION_SAMPLING_PROPORTION=0.5
OPTIMIZATION_SAMPLING_PILOT_SAMPLE_SIZE=100
OPTIMIZATION_SAMPLING_MASTER_POOL_FRACTION=0.10

# Overlay rendering parameters.
OPTIMIZATION_SAMPLING_OVERLAY_COLOR_B=0
OPTIMIZATION_SAMPLING_OVERLAY_COLOR_G=0
OPTIMIZATION_SAMPLING_OVERLAY_COLOR_R=255
OPTIMIZATION_SAMPLING_OVERLAY_THICKNESS=2
OPTIMIZATION_SAMPLING_OVERLAY_ALPHA=1.0
OPTIMIZATION_SAMPLING_SEED=42

# Parallel execution. Leave blank to use all detected CPU cores.
OPTIMIZATION_SAMPLING_NUM_PROCESSES=

# ============================================================
# Stage 3.2: Graph Method Tuning (`3_2_tune_graph_method.py`)
# This script tunes graph-segmentation parameters using the manual
# labels created in `master_candidate_pool/APPROVED` and `REJECTED`.
# ============================================================

# Preferred HDF5-first source for Stage 3.2. Review labels still come from
# `APPROVED` / `REJECTED`, but the reviewed stems resolve back to this dataset.
GRAPH_TUNING_SOURCE_HDF5_PATH=/mnt/host_f/CHILE_OUTPUT/PATCHES/SOURCE_DATASET.h5

# Folder that contains `APPROVED` and `REJECTED` review labels.
GRAPH_TUNING_BASE_DIR=/mnt/host_f/CHILE_OUTPUT/Optimization_Test/master_candidate_pool

# Stage 3.2 log filename written inside `LOG_FOLDER`.
GRAPH_TUNING_LOG_FILE=bayesian_optimization.log
GRAPH_TUNING_OUTPUT_PARAMS_PATH=/mnt/host_f/CHILE_OUTPUT/Optimization_Test/master_candidate_pool/graph_cleaning_params.json

# Dataset split and optimization budget.
GRAPH_TUNING_TEST_SET_SIZE=0.2
GRAPH_TUNING_N_SPLITS_INNER_CV=3
GRAPH_TUNING_N_BAYESIAN_CALLS=50
GRAPH_TUNING_N_INITIAL_POINTS=10
GRAPH_TUNING_RANDOM_STATE=42

# Search-space bounds for Bayesian optimization.
GRAPH_TUNING_BG_INTENSITY_MIN=100
GRAPH_TUNING_BG_INTENSITY_MAX=250
GRAPH_TUNING_K_MIN=100
GRAPH_TUNING_K_MAX=500
GRAPH_TUNING_MIN_SIZE_MIN=10
GRAPH_TUNING_MIN_SIZE_MAX=200
GRAPH_TUNING_EROSION_MIN=0
GRAPH_TUNING_EROSION_MAX=10

# ============================================================
# Stage 3.3: Graph Cleaning (`3_3_cleaner_script.py`)
# This script applies the tuned graph-contamination rule and updates
# row acceptance state in `master_manifest.sqlite`.
# ============================================================

# Preferred HDF5-first source for Stage 3.3.
GRAPH_CLEANING_SOURCE_HDF5_PATH=/mnt/host_f/CHILE_OUTPUT/PATCHES/SOURCE_DATASET.h5

# Base folder where Stage 3.3 writes accepted/rejected manifests.
GRAPH_CLEANING_OUTPUT_BASE_DIR=/mnt/host_f/CHILE_OUTPUT/PATCHES

# Stage 3.3 log filename written inside `LOG_FOLDER`.
GRAPH_CLEANING_LOG_FILE=production_filtering.log

# Required Stage 3.2 artifact consumed by Stage 3.3.
GRAPH_CLEANING_PARAMS_PATH=/mnt/host_f/CHILE_OUTPUT/Optimization_Test/master_candidate_pool/graph_cleaning_params.json

# Parallel execution. Leave blank to use all detected CPU cores.
GRAPH_CLEANING_NUM_WORKERS=

# ============================================================
# ============================================================
# Stage 4: Crossfold Dataset Preparation (`4_crossfold.py`)
# This script creates patient-level TRAIN / VALIDATION / TEST
# splits and can optionally fit stain normalization on TRAIN only.
# ============================================================

# Master manifest source for native Stage 4. Despite the historical variable
# name, this must now point to `master_manifest.sqlite`.
CROSSFOLD_SOURCE_HDF5_PATH=./data/CAMELYON16/master_manifest.sqlite

# Output behavior.
# - `NOT_NORMALIZED` keeps raw staining metadata and writes Stage 4 sidecars plus
#   SQLite split state.
# - `REINHARD`, `RUIFROK`, `MACENKO`, `VAHADANE` fit on TRAIN only and persist the
#   frozen normalization artifacts for later runtime stages.
CROSSFOLD_NORMALIZATION_METHOD=NOT_NORMALIZED

# Random seed used for split search reproducibility.
CROSSFOLD_RANDOM_STATE=42

# If `True`, the stage deletes an existing output run folder such as
# `PATCHES/NOT_NORMALIZED/NOT_NORMALIZED_seed_42` before recreating it.
CROSSFOLD_OVERWRITE_OUTPUT_DIR=True

# Explicit patient capacities for the Stage 4 split search.
# TRAIN receives the remaining patients after TEST and VALIDATION capacities are met.
CROSSFOLD_TEST_PATIENT_COUNT=20
CROSSFOLD_VALIDATION_PATIENT_COUNT=20

# Number of Optuna trials used by the patient-level split optimizer.
CROSSFOLD_SPLIT_OPTUNA_TRIALS=1000

# Parallel entropy settings.
# Leave `CROSSFOLD_ENTROPY_NUM_WORKERS` blank to use the stage default
# (`cpu_count - 1`, with a floor of 1).
CROSSFOLD_ENTROPY_NUM_WORKERS=

# Batch size passed to multiprocessing when scoring image entropy.
CROSSFOLD_ENTROPY_CHUNKSIZE=128

# Thumbnail size used before entropy calculation. Smaller values are faster,
# larger values preserve more spatial detail.
CROSSFOLD_ENTROPY_THUMBNAIL=128

# Stage 4 output HDF5 compression.
# Allowed values: none, lzf, gzip.
# `none` is the current recommended starting point for performance work.
CROSSFOLD_HDF5_COMPRESSION=none

# Number of rows to batch together while building Stage 4 sidecar manifests.
CROSSFOLD_COPY_BATCH_SIZE=1024

# If `True`, save `entropy_cache.csv` and `patient_entropy_median.csv`
# inside the output run folder.
CROSSFOLD_SAVE_ENTROPY_CACHE_CSV=True

# If `True`, compute SHA256 hashes for file-path-based manifests before saving
# `manifest.csv`. HDF5-native manifests do not use per-row image/mask checksums.
CROSSFOLD_CALC_CHECKSUMS=False

# Stage 4 log filename written inside `LOG_FOLDER`.
CROSSFOLD_LOG_FILE=data_preparation.log

# ============================================================
# Stage 5: Scientific Sanity Checks (`5_sanity_checks.py`)
# This script verifies whether the Stage 4 sidecars and split metadata are
# scientifically defensible before downstream training.
# ============================================================

# Folder produced by Stage 4 that contains `manifest.csv`, `split_stats.csv`,
# `run_config.json`, and optional normalization artifacts.
SANITY_BASE_DIR=/mnt/host_f/CHILE_OUTPUT/PATCHES/NOT_NORMALIZED/NOT_NORMALIZED_seed_42

# Number of image/mask pairs to sample for expensive checks when full scans are disabled.
SANITY_SAMPLE_PAIRS=1000

# If `True`, scan every mask for unexpected pixel values instead of only a sample.
SANITY_FULL_MASK_SCAN=False

# If `True`, decode every image/mask pair and verify matching spatial dimensions.
SANITY_FULL_SHAPE_SCAN=False

# Checksum verification mode.
# - `OFF`: skip SHA256 verification completely.
# - `SAMPLE`: verify a sample of rows when checksum columns exist in the manifest.
# - `FULL`: verify every row when checksum columns exist in the manifest.
SANITY_CHECKSUM_MODE=SAMPLE

# If `True`, fail when the same filename appears more than once anywhere in the dataset.
# This protects downstream filename-keyed joins used by artifact-aware training.
SANITY_ENFORCE_FILENAME_UNIQUENESS=True

# If `True`, fail when filenames do not match the expected `PATIENT_<id>_...`
# pattern or when the embedded patient id disagrees with `manifest.csv`.
SANITY_ENFORCE_REGEX_PATIENT_ID_MATCH=True

# If `True`, recompute split-level statistics from `manifest.csv` and compare them
# against the stored `split_stats.csv` provenance artifact.
SANITY_ENFORCE_SPLIT_STATS_PARITY=True

# If `True`, fail when a positive (`CANCER`) sample has an empty mask.
# Set to `False` only if your labeling policy intentionally allows context-only positives.
SANITY_FAIL_ON_EMPTY_CANCER_MASK=True

# If `True`, fail when a negative (`NOT_CANCER`) sample contains positive mask pixels.
SANITY_FAIL_ON_POSITIVE_NOT_CANCER_MASK=True

# Stage 5 log filename written inside `LOG_FOLDER`.
SANITY_LOG_FILE=sanity_checks.log

# ============================================================
# Stage 6: Smart Sampling (`6_smart_sampler.py`)
# This script performs patient-wise, label-aware training-set curation by
# updating `master_manifest.sqlite` and writing selection sidecars.
# ============================================================

# Master manifest used to resolve TRAIN rows and persist Stage 6 decisions.
SMART_SAMPLER_MASTER_MANIFEST_PATH=./data/CAMELYON16/master_manifest.sqlite

# Folder where selection and lineage sidecars are written.
SMART_SAMPLER_OUTPUT_DIR=./data/CAMELYON16

# Output name prefix retained for sidecar compatibility.
SMART_SAMPLER_OUTPUT_FILENAME=TRAIN_FILTERED_shards

# Optional scratch directory used when staging the input HDF5 locally.
# On Colab/Drive, point this to fast VM-local storage such as `/content/smart_sampling`.
SMART_SAMPLER_LOCAL_WORK_DIR=./temp/smart_sampling
# Optional reusable patient-shard cache rooted on local SSD. Leave blank to place
# the cache under `SMART_SAMPLER_LOCAL_WORK_DIR/cache/patient_shards` when enabled.
SMART_SAMPLER_LOCAL_SHARD_CACHE_DIR=
# Size cap in bytes for the reusable local patient-shard cache. Set to `0` to
# disable the cache and use one-shot local staging instead.
SMART_SAMPLER_LOCAL_SHARD_CACHE_BYTES=0
SMART_SAMPLER_STAGE_INPUT_LOCALLY=False
SMART_SAMPLER_STAGE_OUTPUTS_LOCALLY=False
SMART_SAMPLER_CLEAN_LOCAL_WORK_DIR=True

# Write CSV/JSON diagnostics alongside the smart-sampling sidecars.
SMART_SAMPLER_WRITE_SIDECARS=True
SMART_SAMPLER_OVERWRITE_OUTPUT=False

# Embedding extractor runtime.
# Stage 6 now uses Hugging Face Phikon-v2 embeddings only.
SMART_SAMPLER_MODEL_NAME=owkin/phikon-v2
SMART_SAMPLER_BATCH_SIZE=128
SMART_SAMPLER_DEVICE=cuda
SMART_SAMPLER_NUM_WORKERS=2
SMART_SAMPLER_SEED=42

# Stage 6 log filename written inside `LOG_FOLDER`.
SMART_SAMPLER_LOG_FILE=smart_sampler.log

# Adaptive stability loop.
SMART_SAMPLER_N_START=512
SMART_SAMPLER_N_MAX=15000
SMART_SAMPLER_GROWTH_FACTOR=2.0
SMART_SAMPLER_STABILITY_THRESHOLD=0.85
SMART_SAMPLER_STABILITY_REPEATS=3
SMART_SAMPLER_MAX_STEPS=7
SMART_SAMPLER_INTERSECTION_RATIO_THRESHOLD=0.2

# Clustering and per-patient sample caps.
SMART_SAMPLER_K_MIN=20
SMART_SAMPLER_K_MAX=80

# Adaptive per-patient retention. The sampler evaluates plateau stopping with a
# within-patient patch holdout and uses `SMART_SAMPLER_M_MAX` only as a safety
# ceiling for reducible rows. Protected rows bypass reduction and may cause the
# final patient count to exceed `SMART_SAMPLER_M_MAX`.
SMART_SAMPLER_ADAPTIVE_KEEP_ENABLED=True
SMART_SAMPLER_KEEP_MIN=64
SMART_SAMPLER_KEEP_STEP=64
SMART_SAMPLER_KEEP_IMPROVEMENT_THRESHOLD=0.02
SMART_SAMPLER_KEEP_PATIENCE=2
SMART_SAMPLER_M_MAX=2000

# Label-aware protected retention policy.
SMART_SAMPLER_PROTECT_POSITIVE_LABELS=True
SMART_SAMPLER_PROTECT_MASK_POSITIVE=True
SMART_SAMPLER_POSITIVE_MASK_FRACTION_THRESHOLD=0.0

# Feature flag for A/B testing a GIST-based final selector on the patient
# candidate pool on top of the Phikon-v2 embedding space. Leave `False` to use
# the legacy adaptive coverage selector for reducible rows.
SMART_SAMPLER_USE_GIST=False

# ============================================================
# Stage 7: LR Finder (`7_lr_finder.py`)
# This script screens the approved model registry, runs repeated
# LR finder sweeps, and compiles a LaTeX PDF report.
# ============================================================

# Path to the canonical Stage 2 master manifest used to resolve TRAIN and
# VALIDATION rows at startup.
LR_FINDER_MASTER_MANIFEST_PATH=./data/CAMELYON16/master_manifest.sqlite

# Output folder that receives plots, CSVs, report.tex, report.pdf,
# and lr_finder_run_config.json.
LR_FINDER_OUTPUT_DIR=./reports/lr_finder

# Optional local cache folder used when staging patient shards off slower
# storage before screening.
LR_FINDER_LOCAL_DATA_DIR=./temp/lr_finder
LR_FINDER_STAGE_INPUT_LOCALLY=False

# Output management and input selection.
LR_FINDER_OVERWRITE_OUTPUT=True
LR_FINDER_SMART_SAMPLING=True
LR_FINDER_PDF_NAME=report.pdf

# Reproducibility and runtime mode. Modes are 'PAPER' and 'FAST_DEV'
LR_FINDER_EXECUTION_MODE=PAPER
LR_FINDER_AMP_PRECISION=fp16
LR_FINDER_SEED=24
LR_FINDER_BATCH_SIZE=32
LR_FINDER_WORKERS=8

# Optional comma-separated subset of approved architectures from
# training_model_registry.json. Leave blank to screen them all.
LR_FINDER_ARCHITECTURES=

# Stage 7 log filename written inside `LOG_FOLDER`.
LR_FINDER_LOG_FILE=lr_finder.log

# Optional subset mode for faster smoke tests.
LR_FINDER_USE_SUBSET=False
LR_FINDER_SUBSET_RATIO=1.0

# Optional Hugging Face token for timm universal encoders (`tu-*`).
# Supplying it avoids unauthenticated Hub warnings and rate-limit issues
# when pretrained encoder weights are resolved through the HF cache.
HF_TOKEN=

# LR Finder sweep settings.
LR_FINDER_NUM_LHS_SAMPLES=12
LR_FINDER_NUM_REPEATS=3
LR_FINDER_END_LR=0.1
LR_FINDER_NUM_ITER=100
LR_FINDER_OPTIMIZER_START_LR=1e-8
LR_FINDER_OPTIMIZER_WEIGHT_DECAY=1e-4

# BCE + Dice search space for Stage 8 loss screening.
LR_FINDER_ALPHA_MIN=0.1
LR_FINDER_ALPHA_MAX=1.0
LR_FINDER_BETA_MIN=0.1
LR_FINDER_BETA_MAX=0.5
LR_FINDER_GAMMA_MIN=0.1
LR_FINDER_GAMMA_MAX=0.5
LR_FINDER_GAMMA_LOG=False


# ============================================================
# Stage 8: Training Ensemble (`8_training_ensemble.py`)
# This script trains one segmentation model per execution.
# Keep the values below together so users can quickly identify
# where the configuration for this script starts.
# ============================================================

# --- Model selection ---
# Approved research architectures and required encoder pairs:
# - SWIN -> tu-swin_large_patch4_window7_224.ms_in22k_ft_in1k
# - DEEPLABV3PLUS -> tu-resnest101e
# - UNET++ -> efficientnet-b7
# - FPN -> senet154
# - SEGFORMER -> mit_b5
# - MANET -> resnet152
# - DPT -> tu-vit_large_patch16_224.augreg_in21k_ft_in1k
# - UPERNET -> tu-hiera_large_224
# Use exactly one of the architecture values above and the matching encoder.
TRAINING_ARCHITECTURE=FPN
TRAINING_ENCODER=senet154
# Optional checkpoint path used to resume training.
TRAINING_RESUME_CHECKPOINT=
# Optional override for the approved architecture/encoder registry JSON.
TRAINING_MODEL_REGISTRY_PATH=./training_model_registry.json

# --- Dataset and output paths ---
# Master manifest produced by Stage 2 and updated by later metadata stages.
TRAINING_MASTER_MANIFEST_PATH=./data/CAMELYON16/master_manifest.sqlite
# Folder where JSON metadata for the best checkpoint is saved.
TRAINING_METADATA_DIR=./metadata/CAMELYON16
# Local cache folder for canonical Stage 2 patient shards.
TRAINING_LOCAL_DATA_DIR=./temp/training_ensemble
# Folder where model checkpoints are written.
TRAINING_CHECKPOINT_PATH=./checkpoints
# Aim repository folder for experiment tracking.
TRAINING_AIM_REPO_PATH=./aim_repo

# Stage 8 log filename written inside `LOG_FOLDER`.
TRAINING_LOG_FILE=training_ensemble.log

# --- Run identity and reproducibility ---
TRAINING_IDENTIFIER=CAMELYON16_HDF5_OPTIMIZED
TRAINING_EXECUTION_MODE=PAPER
TRAINING_SEED=24
TRAINING_SMART_SAMPLING=True
TRAINING_UNLEASHED=False

# If `True`, scale each training sample's loss using the maximum artifact coverage
# value stored in `master_manifest.sqlite`. This remains independent from
# OHEM: artifact-aware discounting operates at the sample level, while OHEM mines
# hard pixels inside each sample.
TRAINING_USE_ARTIFACT_AWARE_LOSS=False

# If `True`, enable pixel-level Online Hard Example Mining during training only.
# OHEM does not change the dataloader or class sampler. Instead, it computes a
# per-pixel error map inside each patch and backpropagates through only the
# hardest pixels once the configured start epoch is reached.
#
# Validation always runs without OHEM so validation metrics remain comparable to
# the current baseline behavior.
TRAINING_RUN_OHEM=False

# --- Training loop ---
TRAINING_NUM_EPOCHS=100
TRAINING_PATIENCE=5
TRAINING_BATCH_SIZE=32
TRAINING_VAL_BATCH_MULTIPLIER=3
TRAINING_ACCUMULATION_STEPS=4
TRAINING_WORKERS=8
TRAINING_OPTIMIZER_NAME=AdamWScheduleFree
TRAINING_AMP_PRECISION=fp16

# OHEM starts once the 0-based training epoch index reaches this value.
# Example: `2` means epochs 0 and 1 use the standard BCE+Dice loss, and OHEM
# activates from epoch 2 onward.
TRAINING_OHEM_START_EPOCH=2

# Fraction of pixels kept per image when OHEM is active.
# Example: `0.25` means each patch keeps the top 25% highest-loss pixels.
# Larger values behave more like the standard loss; smaller values focus more
# aggressively on difficult pixels.
TRAINING_OHEM_RATIO=0.25

# Safety floor for the number of pixels kept per image when OHEM is active.
# The effective hard-pixel count is:
# `max(round(TRAINING_OHEM_RATIO * num_pixels), TRAINING_OHEM_MIN_KEPT)`
# capped at the total number of pixels in the patch.
# This prevents OHEM from becoming too aggressive on smaller inputs.
TRAINING_OHEM_MIN_KEPT=1024

# --- metric behavior ---
TRAINING_SENSITIVITY_TARGET=0.95

# --- Optional notifications ---
# Leave these blank to disable email notifications.
TRAINING_EMAIL_SENDER=
TRAINING_EMAIL_RECIPIENTS=
TRAINING_EMAIL_PASSWORD=

# ============================================================
# Stage 9: Ensemble Optimizer (`9_optimizer_ensemble.py`)
# This script optimizes the two-stream ensemble recipe consumed
# by Stage 10 inference and writes a declarative JSON artifact.
# ============================================================

# --- Dataset, metadata, and output paths ---
# Master manifest used to resolve VALIDATION rows from Stage 2 patient shards.
ENSEMBLE_OPT_MASTER_MANIFEST_PATH=./data/CAMELYON16/master_manifest.sqlite
# Folder containing *_meta.json files produced by training.
ENSEMBLE_OPT_METADATA_DIR=./metadata/CAMELYON16
# Folder where the final ensemble recipe JSON is written.
ENSEMBLE_OPT_OUTPUT_DIR=./reports/ensemble_optimizer
# Optional local cache folder for canonical Stage 2 patient shards when fast local disk is available.
ENSEMBLE_OPT_LOCAL_DATA_DIR=./temp/ensemble_optimizer
# Folder for cached per-model validation predictions.
ENSEMBLE_OPT_PRED_CACHE_DIR=./temp/ensemble_optimizer_cache
ENSEMBLE_OPT_STAGE_INPUT_LOCALLY=True
ENSEMBLE_OPT_OVERWRITE_OUTPUT=True

# --- Reproducibility and dataloader ---
ENSEMBLE_OPT_SEED=24
ENSEMBLE_OPT_BATCH_SIZE=32
ENSEMBLE_OPT_WORKERS=2

# --- Candidate model selection ---
ENSEMBLE_OPT_SORT_METRIC=best_val_auprc_pixel_score

# --- Validation subset split ---
# Stage 10 now uses VALIDATION patients for three disjoint subsets:
# optimization, calibration, and optional development holdout.
ENSEMBLE_OPT_VAL_CALIBRATION_FRAC=0.25
ENSEMBLE_OPT_VAL_HOLDOUT_FRAC=0.20

# --- Two-stream grouping ---
ENSEMBLE_OPT_SEMANTIC_ARCHITECTURES=SWIN,DPT,SEGFORMER,UPERNET
ENSEMBLE_OPT_SPATIAL_ARCHITECTURES=DEEPLABV3PLUS,UNET++,FPN,MANET

# --- ROI guardrails ---
ENSEMBLE_OPT_ROI_CONTEXT_SCALE=4
ENSEMBLE_OPT_ROI_MAX_MEDIAN=0.60
ENSEMBLE_OPT_ROI_EMPTY_MAX=0.50
ENSEMBLE_OPT_ROI_MIN_POS_RECALL=0.80

# --- Spatial optimization ---
ENSEMBLE_OPT_SPILL_PENALTY_LAMBDA=0.10
ENSEMBLE_OPT_SPATIAL_PATIENT_POLICY=all

# --- Optuna ---
ENSEMBLE_OPT_NUM_TRIALS_SEMANTIC=50
ENSEMBLE_OPT_NUM_TRIALS_SPATIAL=50

# Stage 9 log filename written inside `LOG_FOLDER`.
ENSEMBLE_OPT_LOG_FILE=ensemble_optimizer.log

# ============================================================
# Stage 10: Ensemble Inference (`10_inference_ensemble.py`)
# This script loads the Stage 9 two-stream recipe, evaluates it on
# canonical Stage 2 TEST rows resolved from `master_manifest.sqlite`,
# and exports metrics/reporting artifacts.
# ============================================================

# Recipe JSON produced by Stage 9.
ENSEMBLE_INFER_RECIPE_PATH=./reports/ensemble_optimizer/ENSEMBLE_TWO_STREAM_LATEST.json
# Master manifest used to resolve TEST rows at startup.
ENSEMBLE_INFER_MASTER_MANIFEST_PATH=./data/CAMELYON16/master_manifest.sqlite
# Optional output folder for metrics JSON, confusion matrix, CSV, PDF, and run config.
# Leave blank to write beside the recipe.
ENSEMBLE_INFER_OUTPUT_DIR=
# Optional local cache folder for TEST patient shards when fast local disk is available.
ENSEMBLE_INFER_LOCAL_DATA_DIR=./temp/ensemble_inference
ENSEMBLE_INFER_STAGE_INPUT_LOCALLY=True
ENSEMBLE_INFER_OVERWRITE_OUTPUT=True

# --- Reproducibility and dataloader ---
ENSEMBLE_INFER_SEED=24
ENSEMBLE_INFER_BATCH_SIZE=32
ENSEMBLE_INFER_WORKERS=8

# --- Reporting outputs ---
ENSEMBLE_INFER_VIS_NUM_SAMPLES=10
ENSEMBLE_INFER_EXPORT_CSV=True
ENSEMBLE_INFER_EXPORT_LATEX=True
ENSEMBLE_INFER_EXPORT_VISUALIZATIONS=True

# Stage 10 log filename written inside `LOG_FOLDER`.
ENSEMBLE_INFER_LOG_FILE=ensemble_inference.log
