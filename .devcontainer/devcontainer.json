{
    "name": "GrandQC Experiment Env",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": ".."
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "charliermarsh.ruff", // Added ruff extension for VS Code
                "ms-python.mypy-vscode" // Added mypy extension for VS Code
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/bin/python3",
                "python.testing.pytestEnabled": true,
                "editor.formatOnSave": true,
                "editor.codeActionsOnSave": {
                    "source.fixAll.ruff": "always",
                    "source.organizeImports.ruff": "always"
                }
            }
        }
    },
    "runArgs": [],
    "mounts": [
        "source=${localEnv:HOME}/.opencode,target=/root/.opencode,type=bind",
        // Mount your Windows drives for easy (but slower) data access
        "source=/mnt/c,target=/mnt/c,type=bind",
        "source=/mnt/d,target=/mnt/d,type=bind"
    ],
    "remoteUser": "root"
}